@article{coelho-junior2024,
  title = {Age- and Sex-Specific Normative Values for Muscle Mass Parameters in 18,625 {{Brazilian}} Adults},
  author = {{Coelho-J{\'u}nior}, H{\'e}lio Jos{\'e} and Marques, Fillipi Lopes and Sousa, Caio Victor and Marzetti, Emanuele and Aguiar, Samuel da Silva},
  year = 2024,
  month = jan,
  journal = {Frontiers in Public Health},
  volume = {11},
  publisher = {Frontiers},
  issn = {2296-2565},
  doi = {10.3389/fpubh.2023.1287994},
  urldate = {2026-03-03},
  abstract = {Background: The present study aimed to provide age-and sex-specific normative values for muscle mass parameters in Brazilian adults. Methods: Data pertaining to Brazilian adults (18+ years) who attended a nutritional clinical between January 2018 and July 2022 were analyzed. Muscle mass parameters were assessed using a bioimpedance digital scale (InBody 230, GBC BioMed NZ).Assessments were conducted under standard conditions, with participants refraining from physical exercise for 96 hours and from eating or drinking (including water) for 8 hours before evaluations.Results: A total of 18,625 Brazilian adults were analyzed. Normative values for absolute and relative (height, m 2 ) muscle mass and appendicular muscle mass (ASM) were found. In addition, specific agerelated changes in muscle mass parameters were observed. In women, muscle mass peaks between the ages of 40-49 before gradually declining at an average rate of 5.7\% per decade from the sixth decade of life onwards. ASM reaches its peak earlier, during the third decade of life, and started to decline later, from 50-59 years. In contrast, absolute and ASM peaked at 40-49 years and declined from the sixth decade of life in men. Both sexes displayed a slightly higher decline in ASM than in muscle mass (13\% vs 12\%). Conclusions: The present study provided normative values for absolute and relative muscle mass and ASM in Brazilian adults. Furthermore, important specific age-related changes in muscle mass parameters were observed. These data have public health implications and might serve as reference tables to guide health professionals.},
  langid = {english},
  keywords = {read},
  file = {/Users/annaboss/Zotero/storage/6KAB6XG4/Coelho-Júnior et al. - 2024 - Age- and sex-specific normative values for muscle mass parameters in 18,625 Brazilian adults.pdf}
}

@article{colonetti2017,
  title = {Effects of Whey Protein Supplement in the Elderly Submitted to Resistance Training: Systematic Review and Meta-Analysis.},
  author = {Colonetti, Tamy and Grande, Antonio Jose and Milton, Karen and Foster, Charlie and Alexandre, Maria Cecilia Manenti and Uggioni, Maria Laura Rodrigues and da Rosa, Maria In{\^e}s},
  year = 2017,
  month = may,
  journal = {International journal of food sciences and nutrition},
  volume = {68},
  number = {3},
  pages = {257--264},
  address = {England},
  issn = {1465-3478 0963-7486},
  doi = {10.1080/09637486.2016.1232702},
  abstract = {AIM: We performed a systematic review to map the evidence and analyze the effect of whey protein supplementation in the elderly submitted to resistance training.  METHODS: A comprehensive search on Medline, LILACS, EMBASE, and the Cochrane  Library for relevant publications was conducted until August 2015. The terms used  in the search were: "Resistance training"; "Whey protein"; "Elderly". RESULTS: A  total of 632 studies were screened. Five studies were included composing a sample  of 391 patients. The supplement whey protein was associated with higher total  protein ingestion 9.40 (95\% CI: 4.03-14.78), and with an average change in plasma  leucine concentration. The supplementation was also associated with increased  mixed muscle protein synthesis 1.26 (95\% CI: 0.46-2.07) compared to the control  group. CONCLUSION: We observed an increase in total protein intake, resulting in  increased concentration of leucine and mixed muscle protein fractional synthesis  rate.},
  langid = {english},
  pmid = {27653283},
  keywords = {*Dietary Supplements,*Resistance Training,Aged,Databases Factual,elderly,Humans,meta-analyses,Muscle Proteins/biosynthesis,Muscle Skeletal/drug effects/metabolism,Randomized Controlled Trials as Topic,Systematic review,whey protein,Whey Proteins/*administration & dosage}
}

@article{colonetti2023,
  title = {Whey Protein and Vitamin {{D}} Supplementation in Institutionalized Older Adults: {{A}} Randomized Trial.},
  author = {Colonetti, Tamy and Grande, Ant{\^o}nio Jose and {da Rocha}, Franciani Rodrigues and Ronconi Dondossola, Eduardo and Tuon, Lisiane and Gomes Batista Teles, Hajiv and Minotto Bom, Bruno and Colonetti, Laura and {da Rosa}, Maria In{\^e}s},
  year = 2023,
