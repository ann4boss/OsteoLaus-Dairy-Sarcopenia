@article{flaim2017,
  title = {Effects of a Whey Protein Supplementation on Oxidative Stress, Body Composition and Glucose Metabolism among Overweight People Affected by Diabetes Mellitus or  Impaired Fasting Glucose: {{A}} Pilot Study.},
  author = {Flaim, Chiara and Kob, Michael and Di Pierro, Angela M. and Herrmann, Markus and Lucchin, Lucio},
  year = 2017,
  month = dec,
  journal = {The Journal of nutritional biochemistry},
  volume = {50},
  pages = {95--102},
  address = {United States},
  issn = {1873-4847 0955-2863},
  doi = {10.1016/j.jnutbio.2017.05.003},
  abstract = {Obesity and diabetes mellitus type 2 (DM2) are characterized by chronic inflammation and oxidative stress [Donath et al. 2013] and this leads to  cardiovascular diseases [Hulsmans \& Holvoet 2010]. Whey proteins (WP) have  antioxidant [Chitapanarux et al. 2009], anti-inflammatory [Sugawara et al. 2012]  and hypoglycemic activities [Mignone et al. 2015], while data on weight, body  composition [Frestedt et al. 2008; Aldrich et al. 2011] and blood pressure are  conflicting [Kawase et al. 2000; Lee et al. 2007]. WP have unpleasant taste and  smell [Patel 2015], but a new WP isolate (ProLYOtin\textregistered ) seems to be more palatable.  40 g/die of ProLYOtin\textregistered{} were supplemented to overweight people (n=31) with  impaired fasting glucose/DM2 for 12 weeks. Markers of antioxidant status (total  antioxidant status, glutathione peroxidase, glutathione reductase, uric acid),  oxidative damage (thiobarbituric acid reactive substances, advanced oxidation  protein products, 8-hydroxydeoxyguanosine), inflammation (interleukin-6, high  sensitive reactive protein C) and glicemic status (fasting glucose, insulin,  glycated hemoglobin), anthropometric data (weight, height, waist circumference),  body composition (body cell mass, fat mass), blood pressure, hand grip strength  and skin autofluorescence were measured before and at the end of supplementation.  Isolate palatability was evaluated. An increase in glutathione peroxidase, a  decrease in uric acid and no change in glutathione reductase, total antioxidant  status, oxidative damage, inflammation and glucose markers were found.  Significant improvements in anthropometric parameters and fat mass were detected.  There wasn't any change in blood pressure, skin autofluorescence and physical  performance. Two-thirds of subjects judged the supplement positively. ProLYOtin\textregistered{}  seems suitable for treatment of OS and overweight.},
  copyright = {Copyright \copyright{} 2017 Elsevier Inc. All rights reserved.},
  langid = {english},
  pmid = {29053995},
  keywords = {*Dietary Supplements/adverse effects,*Oxidative Stress,Adiposity,Aged,Antioxidants/adverse effects/therapeutic use,Biomarkers/blood,Body composition,Body Mass Index,Diabetes Mellitus Type 2/blood/complications/*diet therapy,Female,Food Preferences,Glucose Intolerance/blood/complications/*diet therapy,Glucose metabolism,Hand Strength,Humans,Hyperglycemia/*prevention & control,Italy,Male,Middle Aged,Obesity/blood/complications/*diet therapy,Overweight/blood/complications/diet therapy,Oxidative stress,Palatability,Pilot Projects,Skin autofluorescence,Waist Circumference,Whey proteins,Whey Proteins/adverse effects/*therapeutic use}
}

@article{francis2017,
  title = {Twelve Weeks' Progressive Resistance Training Combined with Protein Supplementation beyond Habitual Intakes Increases Upper Leg Lean Tissue Mass,  Muscle Strength and Extended Gait Speed in Healthy Older Women.},
  author = {Francis, Peter and Mc Cormack, William and Toomey, Clodagh and Norton, Catherine and Saunders, Jean and Kerin, Emmet and Lyons, Mark and Jakeman, Philip},
  year = 2017,
  month = dec,
  journal = {Biogerontology},
  volume = {18},
  number = {6},
  pages = {881--891},
  address = {Netherlands},
  issn = {1573-6768 1389-5729},
  doi = {10.1007/s10522-016-9671-7},
  abstract = {The age-related decline in functional capability is preceded by a reduction in muscle quality. The purpose of this study was to assess the combined effects of  progressive resistance training (PRT) and protein supplementation beyond habitual  intakes on upper leg lean tissue mass (LTM), muscle quality and functional  capability in healthy 50-70~years women. In a single-blinded, randomized,  controlled design, 57 healthy older women (age 61.1~\textpm ~5.1~years, 1.61~\textpm ~0.65~m,  65.3~\textpm ~15.3~kg) consumed 0.33~g/kg body mass of a milk-based protein matrix (PRO)  for 12~weeks. Of the 57 women, 29 also engaged in a PRT intervention (PRO~+~PRT).  In comparison to the PRO group (n~=~28), those in the PRO~+~PRT group had an  increase in upper leg LTM [0.04 (95\% CI -0.07 to 0.01) kg vs. 0.13 (95\% CI  0.08-0.18) kg, P~=~0.027], as measured by Dual-energy X-ray absorptiometry; an  increase in knee extensor (KE) torque [-1.6 (95\% CI -7.3 to 4.4~N~m) vs. 10.2  (95\% CI 4.3-15.8~N~m), P~=~0.007], as measured from a maximal voluntary isometric  contraction (Con-Trex MJ; CMV AG); and an increase in extended gait speed [-0.01  (95\% CI -0.52-0.04) m~s(-1) vs. 0.10 (95\% CI 0.05-0.22) m~s(-1), P~=~0.001] as  measured from a maximal 900\,m effort. There was no difference between groups in  the time taken to complete 5 chair rises or the number of chair rises performed  in 30~s (P~{$>~$}0.05). PRT in healthy older women ingesting a dietary protein  supplement is an effective strategy to improve upper leg LTM, KE torque and  extended gait speed in healthy older women.},
  langid = {english},
  pmcid = {PMC5684326},
  pmid = {27933408},
  keywords = {*Gait,*Muscle Strength,*Walking Speed,*Weight Lifting,Aged,Dietary Proteins/*administration & dosage,Female,Functional capability,Healthy aging,Humans,Leg/*physiology,Middle Aged,Muscle Skeletal/*physiology,Muscle strength,Sarcopenia,Single-Blind Method}
}

@article{freitas-simoes2016,
  title = {Nutrients, Foods, Dietary Patterns and Telomere Length: {{Update}} of Epidemiological Studies and Randomized Trials.},
  author = {{Freitas-Simoes}, Tania-Marisa and Ros, Emilio and {Sala-Vila}, Aleix},
  year = 2016,
  month = apr,
  journal = {Metabolism: clinical and experimental},
  volume = {65},
  number = {4},
  pages = {406--415},
  address = {United States},
  issn = {1532-8600 0026-0495},
  doi = {10.1016/j.metabol.2015.11.004},
  abstract = {Identifying simple strategies to prevent or delay age-associated pathologies is a major public health concern. Attrition of telomeres, chromatin structures that  help maintain genome stability, leads to cell death or senescence. Thus telomere  length is a reliable hallmark of biological aging and the risk of developing  age-related chronic diseases through common oxidation and inflammation  mechanisms. Variability in telomere shortening that is independent of  chronological age suggests that it is a modifiable factor, which may be explained  in part by lifestyle variables such as smoking, adiposity, physical exercise, and  diet. Here we summarize data from published studies focused on nutrition  (nutrients, foods, and dietary patterns) and telomere length. Research on the  topic is incipient and most data comes from epidemiologic studies, often  cross-sectional in design. Consistent with well-known evidence of benefit or harm  for chronic age-related diseases, dietary antioxidants and consumption of  antioxidant-rich, plant-derived foods help maintain telomere length. In contrast,  total and saturated fat intake and consumption of refined flour cereals, meat and  meat products, and sugar-sweetened beverages relate to shorter telomeres. Data on  alcohol and dairy products is controversial. There is evidence that adherence to  the Mediterranean diet is associated with longer telomeres. Randomized clinical  trials are limited to seafood-derived long-chain n-3 polyunsaturated fatty acids,  with promising results. To fill the many gaps in our knowledge of the aging  process and confirm nutrition as a useful tool to counteract biological aging  more research is warranted, particularly observational studies using repeated  measurements of telomere length and randomized trials of foods and dietary  patterns with sequential telomere analyses.},
  copyright = {Copyright \copyright{} 2016 Elsevier Inc. All rights reserved.},
  langid = {english},
  pmid = {26975532},
  keywords = {*Diet,*Epidemiologic Factors,*Nutritional Status,*Telomere Shortening,Aging,Animals,Diet Mediterranean,Epidemiologic studies,Food,Humans,Mediterranean diet,Randomized Controlled Trials as Topic,Telomere/*physiology/*ultrastructure}
}

