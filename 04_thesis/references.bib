@article{gvozdenovic2024,
  title = {Impact of {{Vitamin D Status}} and {{Nutrition}} on the {{Occurrence}} of {{Long Bone Fractures Due}} to {{Falls}} in {{Elderly Subjects}} in the {{Vojvodina Region}} of {{Serbia}}.},
  author = {Gvozdenovi{\'c}, Nemanja and {\v S}arac, Ivana and {\'C}ori{\'c}, Andrijana and Karan, Sa{\v s}a and Nikoli{\'c}, Stanislava and {\v Z}drale, Isidora and Mile{\v s}evi{\'c}, Jelena},
  year = 2024,
  month = aug,
  journal = {Nutrients},
  volume = {16},
  number = {16},
  address = {Switzerland},
  issn = {2072-6643},
  doi = {10.3390/nu16162702},
  abstract = {Bone fractures are a significant public health issue among elderly subjects. This study examines the impact of diet and vitamin D status on the risk of long bone  fractures due to falls in elderly subjects in Vojvodina, Serbia. Conducted at the  University Clinical Center of Vojvodina in autumn/winter 2022-2023, the study  included 210 subjects {$>$}65 years: 105 (F: 80/M: 15) with long bone fractures due  to falls and 105 (F: 80/M: 15) controls. Groups were similar regarding age and  BMI. Dietary intakes (by two 24-h recalls) and serum vitamin D levels were  analyzed. The fracture group had a significantly lower median daily vitamin D  intake (1.4 {$\mu$}g/day vs. 5.8 {$\mu$}g/day), intake of calcium, energy, proteins, fats,  fibers, dairy products, eggs, fish, edible fats/oils, and a higher intake of  sweets (p {$<$} 0.001 for all). Serum vitamin D levels were significantly lower in  the fracture group (40.0 nmol/L vs. 76.0 nmol/L, p {$<$} 0.001). Logistic regression  identified serum vitamin D as the most important protective factor against  fractures, and ROC curve analysis indicated that serum vitamin D levels {$>$} 50.5  nmol/L decreased fracture risk. Nutritional improvements (increased intake of  vitamin D and protein sources such as fish, eggs, and dairy), increased sun  exposure, and routine vitamin D supplementation during winter are advised.},
  langid = {english},
  pmcid = {PMC11356805},
  pmid = {39203838},
  keywords = {*Accidental Falls/prevention & control/statistics & numerical data,*Diet,*Fractures Bone/epidemiology/etiology,*Nutritional Status,*Vitamin D/blood/administration & dosage,Aged,Aged 80 and over,diet,elderly population,Female,fracture,frailty,Humans,Male,Risk Factors,Serbia/epidemiology,vitamin D,Vitamin D Deficiency/blood/epidemiology/complications}
}

@article{gwala2025,
  title = {Textural Aspects and Digestibility of a High-Protein Dessert Using {{INFOGEST}}'s Adult and Older Adult Static in Vitro Digestion Models.},
  author = {Gwala, Shannon and Tang, Qi and Hogan, Sean A. and Giblin, Linda and Brodkorb, Andr{\`\cyrchar\cyre}},
  year = 2025,
  month = aug,
  journal = {Food research international (Ottawa, Ont.)},
  volume = {214},
  pages = {116552},
  address = {Canada},
  issn = {1873-7145 0963-9969},
  doi = {10.1016/j.foodres.2025.116552},
  abstract = {Protein-rich foods tailored to older adult's dietary needs, textures and digestive capabilities are essential to help mitigate sarcopenia and  malnutrition. This study developed two high protein dulce de leche type of  desserts that were enriched with whey protein isolate (WPI-DD) alone or in  combination with whey protein hydrolysate (WPI~+~WPH-DD). Their texture, rheology  and tribology were characterized against a conventional dulce de leche (control).  Protein digestibility was assessed using INFOGEST's in vitro static digestions  simulating the adult and older adult gastrointestinal tract (G.I.T). Amino acid  profiling revealed an expected increase in total amino acid content 68.4~mg/g  (control) to 183.9 and 188.11~mg/g product, with leucine increasing from 5.5 to  19.7 and 20.37~mg/g product, for WPI-DD and WPI~+~WPH-DD respectively. Both  protein-enriched products had a lower firmness and viscoelastic moduli than the  control. In the presence of saliva, WPI~+~WPH-DD showed higher friction  coefficients in the boundary and mixed regimes than WPI-DD and the control,  indicating reduced lubrication. Size-exclusion chromatography revealed lower  gastric proteolysis in the older adult model, with whey proteins resisting pepsin  hydrolysis in both age models. Small intestine proteolysis was highly efficient  for the enriched desserts, with less pronounced age-related differences. The  hydrolysate-containing formulation showed faster leucine release. Both whey-based  formulations achieved {$>$}95~\% protein digestibility, with digestible indispensable  amino acid ratios (DIAAR\%) {$\geq$}100~\%, even under older adult conditions. Coupling  INFOGEST's age-specific in vitro digestion models with texture, rheology and  tribology profiling provides insights into designing food for older adults that  meet both nutritional and textural needs.},
  copyright = {Copyright \copyright{} 2025. Published by Elsevier Ltd.},
  langid = {english},
  pmid = {40467192},
  keywords = {*Dietary Proteins/metabolism,*Digestion,*Whey Proteins/metabolism/chemistry,Adult,Aged,Ageing,Amino Acids/analysis,Dulce de leche,Gastrointestinal digestion,Gastrointestinal Tract/metabolism,Humans,Models Biological,Older adults,Protein Hydrolysates/metabolism,Rheology,Tribology,Whey protein,Whey protein hydrolysate}
}

@article{hall2022,
  title = {Association of {{Genetically Predicted BCAA Levels}} with {{Muscle Fiber Size}} in {{Athletes Consuming Protein}}.},
  author = {Hall, Elliott C. R. and Semenova, Ekaterina A. and Bondareva, Elvira A. and Andryushchenko, Liliya B. and Larin, Andrey K. and Ci{\k e}szczyk, Pawel and Generozov, Edward V. and Ahmetov, Ildus I.},
  year = 2022,
  month = feb,
  journal = {Genes},
  volume = {13},
