  title = {Branched-Chain Amino Acid and Branched-Chain Ketoacid Ingestion Increases Muscle Protein Synthesis Rates in Vivo in Older Adults: A Double-Blind, Randomized  Trial.},
  author = {Fuchs, Cas J. and Hermans, Wesley J. H. and Holwerda, Andrew M. and Smeets, Joey S. J. and Senden, Joan M. and {van Kranenburg}, Janneau and Gijsen, Annemie P. and Wodzig, Will K. H. W. and Schierbeek, Henk and Verdijk, Lex B. and {van Loon}, Luc J. C.},
