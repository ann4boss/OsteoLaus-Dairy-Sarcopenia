@article{marzetti2018,
  title = {Age-Related Changes of Skeletal Muscle Mass and Strength among {{Italian}} and {{Taiwanese}} Older People: {{Results}} from the {{Milan EXPO}} 2015 Survey and the {{I-Lan Longitudinal Aging Study}}},
  shorttitle = {Age-Related Changes of Skeletal Muscle Mass and Strength among {{Italian}} and {{Taiwanese}} Older People},
  author = {Marzetti, Emanuele and Hwang, An-Chun and Tosato, Matteo and Peng, Li-Ning and Calvani, Riccardo and Picca, Anna and Chen, Liang-Kung and Landi, Francesco},
  year = 2018,
  month = feb,
  journal = {Experimental Gerontology},
  volume = {102},
  pages = {76--80},
  issn = {0531-5565},
  doi = {10.1016/j.exger.2017.12.008},
  urldate = {2026-02-24},
  abstract = {Background Muscle mass and strength ineluctably decline with advancing age. Yet, the impact of ethnicity on the pattern of changes and their magnitude is unclear. The aims of the present study were to analyze age- and gender-specific changes in measures of muscle mass and strength among community-living persons and to identify differences between Caucasian and Asian participants. Methods The Italian survey (``Longevity Check-up''), conducted during Milan EXPO 2015, consisted of a population assessment aimed at evaluating the prevalence of specific health metrics in persons outside of a conventional research setting (n=1924), with a special focus on muscle mass and strength. The Taiwanese survey used the first-wave sampling from the I-Lan Longitudinal Aging Study (ILAS) collected from August 2011 to August 2013 (n=1839). ILAS was designed to explore the interrelationship between sarcopenia and frailty in community-dwelling older people in Taiwan. In both studies, muscle mass was estimated by measuring the calf circumference (CC), whereas muscle strength was assessed by handgrip strength testing. Results The mean age of the 1924 Italian participants was 62.5years (standard deviation 8.3, range from 50 to 98years), of whom 1031 (53.6\%) were women. Similarly, the mean age of the Taiwanese sample was 63.9years (standard deviation 9.3, range from 50 to 92years), with 966 (52.5\%) women. CC declined with age in both genders and was significantly greater among Italian participants compared with Taiwanese people in all age groups. A similar effect of age was observed for muscle strength. As for CC, muscle strength was significantly greater among Italian persons relative to Taiwanese participants. Conclusion Muscle mass and strength declined with age in both ethnic groups. Caucasians showed greater muscle mass and performed better than their Asian counterparts. However, the age at which declines began to appear and the rate of decline during aging were comparable between the two populations.},
  keywords = {Ethnicity,Muscle function,Physical performance,Sarcopenia,Trajectory},
  file = {/Users/annaboss/Zotero/storage/58747AEN/Marzetti et al. - 2018 - Age-related changes of skeletal muscle mass and strength among Italian and Taiwanese older people R.pdf;/Users/annaboss/Zotero/storage/CPSZCTS5/S0531556517307520.html}
}

@article{miyazaki2023,
  title = {Associations between Dairy Consumption and the Physical Function in {{Japanese}} Community-Dwelling Older Adults: {{The Shimane CoHRE}} Study.},
  author = {Miyazaki, Ryo and Abe, Takafumi and Sakane, Naoki and Ando, Hitoshi and Yano, Shozo and Okuyama, Kenta and Isomura, Minoru and Yamasaki, Masayuki and Nabika, Toru},
  year = {2023 Sep-Oct},
  journal = {Geriatric nursing (New York, N.Y.)},
  volume = {53},
  pages = {19--24},
  address = {United States},
  issn = {1528-3984 0197-4572},
  doi = {10.1016/j.gerinurse.2023.06.014},
  abstract = {OBJECTIVES: We investigated sex differences in the associations between dairy consumption and the physical function among community-dwelling older adults.  METHODS: Six hundred and fifty-six older adults (75.6~\textpm ~6.4 years old)  participated in this study. Dairy consumption (5-item Likert score) and the  physical function (gait speed, handgrip strength, and skeletal muscle mass) were  measured. The linear and quadratic associations between dairy consumption and the  physical function measures were examined by a multiple linear regression analysis  adjusted for covariates. RESULTS: Among women, an increased dairy consumption was  significantly linearly associated with greater hand-grip strength and faster gait  speed (both p{$<$}0.05) after adjusting for covariates. Among men, dairy consumption  was not associated with the physical function measures. Dairy consumption was not  associated with the muscle mass in either sex. CONCLUSIONS: Increased dairy  consumption was associated with a superior physical function in older women.},
  copyright = {Copyright \copyright{} 2023 Elsevier Inc. All rights reserved.},
  langid = {english},
  pmid = {37406501},
  keywords = {*Dairy Products,*Hand Strength/physiology,*Independent Living,Aged,Aged 80 and over,East Asian People,Female,Gait speed,Grip strength,Humans,Male,Milk,Nutrient status,Protein,read,Walking Speed},
